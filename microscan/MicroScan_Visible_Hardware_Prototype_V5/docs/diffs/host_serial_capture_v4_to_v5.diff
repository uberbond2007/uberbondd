+def _error_line(buf: bytes):
+    """Return a complete firmware 'ERROR ...' text line found in pre-packet bytes, else None."""
+    start = 0
+    while True:
+        pos = buf.find(ERROR_PREFIX, start)
+        if pos < 0:
+            return None
+        if pos == 0 or buf[pos - 1:pos] in (b'\n', b'\r'):
+            end = buf.find(b'\n', pos)
+            if end >= 0:
+                return buf[pos:end].strip().decode('ascii', 'replace')[:200]
+            return None
+        start = pos + 1
+
