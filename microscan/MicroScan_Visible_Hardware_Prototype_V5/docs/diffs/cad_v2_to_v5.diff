+def build_board_envelope():
+    """NOMINAL keep-out solids for interference checks only. Not a model of a real unit."""
+    xs = pin_xs()
+    row_cx = (xs[0] + xs[-1]) / 2
+    parts = {}
+    parts['pcb'] = box(PCB_L, PCB_W, PCB_T, BOARD_CX, BOARD_CY, PCB_UNDER_Z)
+    hdr = None
+    pins = None
+    tails = None
+    for s in (-1, 1):
+        y = BOARD_CY + s * HDR_ROW_SPACING / 2
+        b = box(HDR_PINS * HDR_PITCH, HDR_BODY_H, HDR_BODY_H, row_cx, y, PCB_UNDER_Z - HDR_BODY_H)
+        hdr = b if hdr is None else hdr.union(b)
+        for x in xs:
+            p = box(HDR_PIN_SQ, HDR_PIN_SQ, HDR_PIN_BELOW_BODY, x, y, PCB_UNDER_Z - HDR_BODY_H - HDR_PIN_BELOW_BODY)
+            pins = p if pins is None else pins.union(p)
+            t = box(HDR_PIN_SQ, HDR_PIN_SQ, HDR_TAIL_ABOVE_PCB, x, y, PCB_TOP_Z)
+            tails = t if tails is None else tails.union(t)
+    parts['header_bodies'] = hdr
+    parts['header_pins'] = pins
+    parts['solder_tails'] = tails
+    parts['module'] = box(MODULE_L, MODULE_W, MODULE_H, ANT_END_X + MODULE_L / 2, BOARD_CY, PCB_UNDER_Z - MODULE_H)
+    parts['usb_plug'] = box(USB_PLUG_L, USB_PLUG_W, USB_PLUG_H, USB_END_X + USB_PLUG_L / 2 - 1.0, BOARD_CY,
+                            CABLE_CENTRE_Z - USB_PLUG_H / 2)
+    parts['camera_stack'] = box(20.0, 16.0, CAMERA_STACK_ABOVE_PCB, ANT_END_X + 17.0, BOARD_CY, PCB_TOP_Z)
+    return parts
+
+
+def clip_overlap(shift):
+    """Plan overlap of a retainer onto the nominal PCB long edge for a given slot shift."""
+    tip = PILLAR_CY - (CLIP_L / 2 - CLIP_BODY_SHIFT_OUT) - shift
+    return PCB_W / 2 - tip
+
+
+def placed_clips(shift=CLIP_NOMINAL_SHIFT):
+    """Clips at their pillars, long axis across the board (Y). shift>0 slides toward the board."""
+    out = []
+    for (x, y) in pillar_xy():
+        s = 1 if y > 0 else -1
+        c = build_clip().rotate((0, 0, 0), (0, 0, 1), 90 if s > 0 else -90)
+        # after rotation local -X points toward the board on both sides
+        out.append(c.translate((x, y - s * shift, PILLAR_TOP_Z)))
+    return out
+
