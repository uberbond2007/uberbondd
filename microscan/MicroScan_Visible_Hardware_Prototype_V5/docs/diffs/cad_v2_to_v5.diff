+carrier = build_carrier()
+clip = build_clip()
+gauge = build_gauge()
+envelope = build_board_envelope()
+solids = {'Open_Camera_Carrier_V5': carrier,
+          'Adjustable_Edge_Retainer_V5': clip,
+          'HW818_Nominal_PCB_Gauge_DO_NOT_MOUNT': gauge}
