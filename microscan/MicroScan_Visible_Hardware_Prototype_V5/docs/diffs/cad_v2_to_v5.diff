+# ---------------------------------------------------------------- board (UNVERIFIED)
+PCB_L = 48.5            # [3P] HW-818 "27*48.5*4.5mm"; photo aspect 1.81 agrees, 40x27 does not
+PCB_W = 27.0            # [3P]
+PCB_T = 1.6             # [STD] ASSUMED; measure. Thinner board -> retainers need a shim
+HDR_ROW_SPACING = 22.86 # [STD] 0.9 in, as on AI-Thinker ESP32-CAM; MEASURE before printing
+HDR_PINS = 8            # [PHOTO] 8 pins per side, silk 5V..IO4 / 3V3..GND
+HDR_PITCH = 2.54        # [STD]
+HDR_PIN1_FROM_ANT_END = 17.6   # [PHOTO] centre of first pin from antenna-end edge, +-1 mm
+HDR_BODY_H = 2.54       # [STD] plastic spacer of a male header
+HDR_PIN_BELOW_BODY = 6.1       # [STD] mating length of a standard 11.6 mm header pin
+HDR_PIN_SQ = 0.64       # [STD]
+USB_PLUG_L = 19.0       # [STD] typical Micro-B overmold length; cables vary 17-23
+USB_PLUG_W = 11.0       # [STD]
+USB_PLUG_H = 8.0        # [STD] worst-case overmold thickness
+USB_CENTRE_BELOW_PCB = 1.35    # [STD] receptacle mounted on the under (module) face
+MODULE_L, MODULE_W, MODULE_H = 25.5, 18.0, 3.2   # [STD] ESP-32S module with can, under face
+CAMERA_STACK_ABOVE_PCB = 6.5   # [PHOTO/STD] SD slot + camera head, estimate only
+
+# ---------------------------------------------------------------- carrier (DESIGN)
+PLATE_X, PLATE_Y, PLATE_Z = 84.0, 58.0, 3.2     # footprint retained from V2
+PLATE_FILLET = 5.0
+ANT_END_X = -40.0       # board antenna-end edge; USB end lands at +8.5
+BOARD_CY = 0.0
+USB_END_X = ANT_END_X + PCB_L
+BOARD_CX = ANT_END_X + PCB_L / 2
+
+STRAP_SLOT_X, STRAP_SLOT_Y = 22.0, 4.0          # for one 20 mm hook-and-loop strap
+STRAP_SLOT_CY = 24.5    # slots now on the two LONG edges; strap wraps across the 58 mm axis
+
+RAIL_H = 5.4            # header plastic rests on rail tops
+RAIL_W = 4.6
+RAIL_END_MARGIN = 4.0   # rail extends this far beyond the end pin centres
+TROUGH_W = 1.5          # 0.64 pin + 0.43 float each side
+TROUGH_END_CLEAR = 2.0  # along the row, each end (absorbs the +-1 mm photo uncertainty)
+TROUGH_INTO_PLATE = 1.4 # blind; leaves PLATE_Z-1.4 = 1.8 mm solid floor toward the skin
+
+PCB_UNDER_Z = PLATE_Z + RAIL_H + HDR_BODY_H     # 11.14
+PCB_TOP_Z = PCB_UNDER_Z + PCB_T                 # 12.74
+
+PILLAR_D = 7.0
+PILLAR_LOCAL_X = (19.0, 33.5)   # along the header region: edge strip there is only solder joints
+PILLAR_CY = 17.5
+BOLT_CLEAR_D = 3.4      # M3 + 0.4 for FDM
+HEAD_POCKET_D = 6.6     # pan head dk<=6.0 + 0.6
+HEAD_POCKET_DEPTH = 2.6 # pan head k<=2.4 + 0.2 -> head sits below the skin-side face
+PILLAR_TOP_Z = PCB_TOP_Z
+
+CLIP_L, CLIP_W, CLIP_T = 14.0, 6.0, 3.0
+CLIP_SLOT_L, CLIP_SLOT_W = 8.3, 3.4
+CLIP_BODY_SHIFT_OUT = 1.5   # body centre shifted AWAY from the board so mid-slot gives 1.5 mm edge overlap
+CLIP_NOMINAL_SHIFT = -0.5    # recommended setting: 1.0 mm overlap, clear of the header solder tails
+HDR_TAIL_ABOVE_PCB = 1.4     # [STD] 3.0 mm solder tail minus 1.6 mm PCB
+
+SADDLE_X = 37.0         # cable/boot support + tie point, outboard of a 19 mm plug
+SADDLE_LEN_X, SADDLE_W_Y = 4.0, 9.0
+CABLE_CENTRE_Z = PCB_UNDER_Z - USB_CENTRE_BELOW_PCB
+SADDLE_TOP_Z = CABLE_CENTRE_Z - 0.8
+SADDLE_V_DEPTH = 3.0
+TIE_WIN_X, TIE_WIN_Y = 3.6, 2.7
