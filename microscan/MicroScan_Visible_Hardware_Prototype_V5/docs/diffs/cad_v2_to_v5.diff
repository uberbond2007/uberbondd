+def build_assembly():
+    asm = cq.Assembly(name='MicroScan_V5_nominal_assembly')
+    asm.add(carrier, name='carrier', color=cq.Color(0.80, 0.90, 0.92))
+    for i, c in enumerate(placed_clips()):
+        asm.add(c, name=f'retainer_{i+1}', color=cq.Color(0.0, 0.5, 0.47))
+    colors = {'pcb': (0.1, 0.1, 0.1), 'header_bodies': (0.2, 0.2, 0.2), 'header_pins': (0.8, 0.7, 0.2),
+              'module': (0.7, 0.7, 0.7), 'solder_tails': (0.8, 0.7, 0.2), 'usb_plug': (0.3, 0.3, 0.3), 'camera_stack': (0.5, 0.5, 0.55)}
