+def pin_xs():
+    x1 = ANT_END_X + HDR_PIN1_FROM_ANT_END
+    return [x1 + i * HDR_PITCH for i in range(HDR_PINS)]
+
+
+def pillar_xy():
+    return [(ANT_END_X + lx, s * PILLAR_CY) for lx in PILLAR_LOCAL_X for s in (-1, 1)]
+
+
+def box(lx, ly, lz, cx, cy, z0):
+    return cq.Workplane('XY').box(lx, ly, lz, centered=(True, True, False)).translate((cx, cy, z0))
+
+
+def build_carrier():
+    xs = pin_xs()
+    row_cx = (xs[0] + xs[-1]) / 2
+    row_len = xs[-1] - xs[0]
+    base = cq.Workplane('XY').rect(PLATE_X, PLATE_Y).extrude(PLATE_Z).edges('|Z').fillet(PLATE_FILLET)
+    # strap slots on the long edges
+    for s in (-1, 1):
+        base = base.cut(box(STRAP_SLOT_X, STRAP_SLOT_Y, PLATE_Z + 2, 0, s * STRAP_SLOT_CY, -1))
+    # header rails with blind pin troughs
+    rail_len = row_len + 2 * RAIL_END_MARGIN
+    for s in (-1, 1):
+        y = BOARD_CY + s * HDR_ROW_SPACING / 2
+        base = base.union(box(rail_len, RAIL_W, RAIL_H, row_cx, y, PLATE_Z))
+    # retainer pillars, webbed to the rails
+    for (x, y) in pillar_xy():
+        s = 1 if y > 0 else -1
+        base = base.union(cq.Workplane('XY').circle(PILLAR_D / 2).extrude(PILLAR_TOP_Z - PLATE_Z).translate((x, y, PLATE_Z)))
+        rail_outer = BOARD_CY + s * (HDR_ROW_SPACING / 2 + RAIL_W / 2)
+        web_len = abs(y - rail_outer)
+        base = base.union(box(4.0, web_len, RAIL_H, x, (y + rail_outer) / 2, PLATE_Z))
+    # cable saddle with V groove
+    saddle = box(SADDLE_LEN_X, SADDLE_W_Y, SADDLE_TOP_Z - PLATE_Z, SADDLE_X, 0, PLATE_Z)
+    vee = (cq.Workplane('YZ').polyline([(-SADDLE_V_DEPTH, SADDLE_TOP_Z + 0.01), (0, SADDLE_TOP_Z - SADDLE_V_DEPTH),
+                                        (SADDLE_V_DEPTH, SADDLE_TOP_Z + 0.01)]).close()
+           .extrude(SADDLE_LEN_X + 2).translate((SADDLE_X - SADDLE_LEN_X / 2 - 1, 0, 0)))
+    base = base.union(saddle.cut(vee))
+    # --- cuts after all unions
+    for s in (-1, 1):
+        y = BOARD_CY + s * HDR_ROW_SPACING / 2
+        depth = RAIL_H + TROUGH_INTO_PLATE
+        base = base.cut(box(row_len + HDR_PIN_SQ + 2 * TROUGH_END_CLEAR, TROUGH_W, depth + 0.01,
+                            row_cx, y, PLATE_Z - TROUGH_INTO_PLATE))
+    for (x, y) in pillar_xy():
+        base = base.cut(cq.Workplane('XY').circle(BOLT_CLEAR_D / 2).extrude(PILLAR_TOP_Z + 2).translate((x, y, -1)))
+        base = base.cut(cq.Workplane('XY').circle(HEAD_POCKET_D / 2).extrude(HEAD_POCKET_DEPTH).translate((x, y, 0)))
+    for s in (-1, 1):
+        base = base.cut(box(TIE_WIN_X, TIE_WIN_Y, PLATE_Z + 2, SADDLE_X, s * TIE_WIN_CY, -1))
+    base = base.cut(box(TIE_WIN_X, 2 * TIE_WIN_CY + TIE_WIN_Y, TIE_CHANNEL_DEPTH, SADDLE_X, 0, 0))
+    # engraved identification on both sides of the cable run
+    for s in (-1, 1):
+        txt = (cq.Workplane('XY').text(LABEL, LABEL_SIZE, LABEL_DEPTH + 0.01, font='Liberation Sans', kind='bold',
+                                       combine=True).translate((LABEL_CX, s * LABEL_CY, PLATE_Z - LABEL_DEPTH)))
+        base = base.cut(txt)
+    return base
+
+
+def build_clip():
+    clip = cq.Workplane('XY').box(CLIP_L, CLIP_W, CLIP_T, centered=(True, True, False)).translate((CLIP_BODY_SHIFT_OUT, 0, 0))
+    clip = clip.edges('|Z').fillet(1.0)
+    slot = cq.Workplane('XY').slot2D(CLIP_SLOT_L, CLIP_SLOT_W, angle=0).extrude(CLIP_T + 2).translate((0, 0, -1))
+    return clip.cut(slot)
+
+
+def build_gauge():
+    """Flat coupon of the NOMINAL outline with pin holes. Lay the real board on it to compare."""
+    g = cq.Workplane('XY').box(PCB_L, PCB_W, PCB_T, centered=(True, True, False)).translate((BOARD_CX, BOARD_CY, 0))
+    for x in pin_xs():
+        for s in (-1, 1):
+            g = g.cut(cq.Workplane('XY').circle(0.6).extrude(PCB_T + 2).translate((x, BOARD_CY + s * HDR_ROW_SPACING / 2, -1)))
+    # USB-end notch so orientation cannot be confused
+    g = g.cut(box(1.5, 8.0, PCB_T + 2, USB_END_X - 0.75, BOARD_CY, -1))
+    return g
+
