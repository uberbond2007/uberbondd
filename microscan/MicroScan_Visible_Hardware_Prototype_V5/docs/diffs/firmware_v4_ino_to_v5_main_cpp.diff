+class IndicatorScope {
+ public:
+  IndicatorScope() { digitalWrite(CAPTURE_INDICATOR_GPIO, HIGH); }
+  ~IndicatorScope() { digitalWrite(CAPTURE_INDICATOR_GPIO, LOW); }
+  IndicatorScope(const IndicatorScope&) = delete;
+  IndicatorScope& operator=(const IndicatorScope&) = delete;
+  // Confirms the GPIO latch, not photons. A dead LED is a physical-inspection item.
+  bool lit() const { return digitalRead(CAPTURE_INDICATOR_GPIO) == HIGH; }
+};
