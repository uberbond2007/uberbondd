+// Software JPEG sink for sensors without a hardware encoder.
+struct JpegSink {
+  uint8_t* buf;
+  size_t cap;
+  size_t len;
+  bool overflow;
+};
+static size_t jpeg_sink_cb(void* arg, size_t index, const void* data, size_t len) {
+  JpegSink* sink = static_cast<JpegSink*>(arg);
+  if (index + len > sink->cap) {
+    sink->overflow = true;
+    return 0;
+  }
+  memcpy(sink->buf + index, data, len);
+  if (index + len > sink->len) sink->len = index + len;
+  return len;
+}
